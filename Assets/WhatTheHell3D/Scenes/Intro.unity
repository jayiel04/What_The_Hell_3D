--- !u!114 &1003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6e8f0a2b4c57139e7054c0a1b326d98, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  subtitleText: {fileID: 840904902}
  skipButton: {fileID: 1605353102}
  fadeImage: {fileID: 656506335}
  voiceSource: {fileID: 1837042320}
  lines:
  - text: Hubo un tiempo en que la luz protegia estas tierras...
    duration: 3
    voice: {fileID: 8300000, guid: 9e07d412bbe021cacbc991b4827bebce, type: 3}
  - text: Hasta que una sombra la devoro por completo.
    duration: 3
    voice: {fileID: 8300000, guid: e685e36a4cdf56a988e6e1d143d90040, type: 3}
  - text: Los reinos cayeron uno tras otro.
    duration: 1.8
    voice: {fileID: 8300000, guid: 2f849a05ef41795eaaa451b014f9cfb0, type: 3}
  - text: Sus guardianes lucharon... y desaparecieron.
    duration: 1.8
    voice: {fileID: 8300000, guid: 418a8011f2e756c4399208de5f5a9620, type: 3}
  - text: Solo quedaron ruinas... y silencio.
    duration: 2.2
    voice: {fileID: 8300000, guid: 4a5e576534d7681319606addd165fa29, type: 3}
  - text: No recuerdas quien eres...
    duration: 2.2
    voice: {fileID: 8300000, guid: 929de0b6e6dd0696d9ac9148dbb7eec6, type: 3}
  - text: Ni por que despertaste aqui.
    duration: 2.4
    voice: {fileID: 8300000, guid: 89024317d7800de189467d45caecbfb4, type: 3}
  - text: Pero mientras una llama siga encendida...
    duration: 2.2
    voice: {fileID: 8300000, guid: 143d4ed7cb53883a7b5697c5e6542302, type: 3}
  - text: ...la oscuridad nunca habra vencido.
    duration: 2.6
    voice: {fileID: 8300000, guid: 2f4e71b79fb10d999a3811e007eaabcb, type: 3}
  - text: Si aun respiras...
    duration: 2.2
    voice: {fileID: 8300000, guid: 16dfe48724e28516b87e4d3ef6c147a8, type: 3}
  - text: ...es porque el destino aun no ha terminado contigo.
    duration: 2.8
    voice: {fileID: 8300000, guid: 5bd5ed5827954552cac0ef16813f34b4, type: 3}
  - text: Levantate.
    duration: 1.8
    voice: {fileID: 8300000, guid: 03c370c3b0d6f1bb8a9811a21446e9e7, type: 3}
  - text: La ultima esperanza... camina contigo.
    duration: 3
    voice: {fileID: 8300000, guid: e113d7b7f4c7a4b378ae4bd9c5925801, type: 3}
