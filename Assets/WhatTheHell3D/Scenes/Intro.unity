--- !u!114 &1004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a71a8986ddde29f8fa90f189ba3ab5c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: WhatTheHell3D.Runtime::IntroCutsceneDirector
  player: {fileID: 2124045923}
  moonLight: {fileID: 2006502653}
  gateGlow: {fileID: 562372945}
  castleLight: {fileID: 1503180151}
  cutsceneCamera: {fileID: 1988913857}
  subtitleText: {fileID: 186686110}
  fadeImage: {fileID: 997371276}
  skipButton: {fileID: 853196435}
  ambience: {fileID: 1037147165}
  bell: {fileID: 1747583517}
  breath: {fileID: 1194907073}
  footsteps: {fileID: 115982315}
  voice: {fileID: 1321434554}
  lines:
  - text: Hubo un tiempo en que la luz protegia estas tierras...
    duration: 3
    clip: {fileID: 8300000, guid: 9e07d412bbe021cacbc991b4827bebce, type: 3}
  - text: Hasta que una sombra la devoro por completo.
    duration: 3
    clip: {fileID: 8300000, guid: e685e36a4cdf56a988e6e1d143d90040, type: 3}
  - text: Los reinos cayeron uno tras otro.
    duration: 1.8
    clip: {fileID: 8300000, guid: 2f849a05ef41795eaaa451b014f9cfb0, type: 3}
  - text: Sus guardianes lucharon... y desaparecieron.
    duration: 1.8
    clip: {fileID: 8300000, guid: 418a8011f2e756c4399208de5f5a9620, type: 3}
  - text: Solo quedaron ruinas... y silencio.
    duration: 2.2
    clip: {fileID: 8300000, guid: 4a5e576534d7681319606addd165fa29, type: 3}
  - text: No recuerdas quien eres...
    duration: 2.2
    clip: {fileID: 8300000, guid: 929de0b6e6dd0696d9ac9148dbb7eec6, type: 3}
  - text: Ni por que despertaste aqui.
    duration: 2.4
    clip: {fileID: 8300000, guid: 89024317d7800de189467d45caecbfb4, type: 3}
  - text: Muchos caminaron este sendero...
    duration: 1.8
    clip: {fileID: 8300000, guid: ba71b1b955776150b842e0ae809151f7, type: 3}
  - text: Ninguno consiguio regresar.
    duration: 1.8
    clip: {fileID: 8300000, guid: e0ff0fc3a1b8aea80bacd511a0c4756c, type: 3}
  - text: Pero mientras una llama siga encendida...
    duration: 2.2
    clip: {fileID: 8300000, guid: 143d4ed7cb53883a7b5697c5e6542302, type: 3}
  - text: ...la oscuridad nunca habra vencido.
    duration: 2.6
    clip: {fileID: 8300000, guid: 2f4e71b79fb10d999a3811e007eaabcb, type: 3}
  - text: Si aun respiras...
    duration: 2.2
    clip: {fileID: 8300000, guid: 16dfe48724e28516b87e4d3ef6c147a8, type: 3}
  - text: ...es porque el destino aun no ha terminado contigo.
    duration: 2.8
    clip: {fileID: 8300000, guid: 5bd5ed5827954552cac0ef16813f34b4, type: 3}
  - text: Levantate.
    duration: 1.8
    clip: {fileID: 8300000, guid: 03c370c3b0d6f1bb8a9811a21446e9e7, type: 3}
  - text: La ultima esperanza... camina contigo.
    duration: 3
    clip: {fileID: 8300000, guid: e113d7b7f4c7a4b378ae4bd9c5925801, type: 3}
  characterModelPath: Characters/Knight_Male.gltf
  nextScenePath: Assets/WhatTheHell3D/Scenes/CampaignLevel01.unity
